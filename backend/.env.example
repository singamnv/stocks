# Get a free key at https://finnhub.io
FINNHUB_API_KEY=
CORS_ORIGIN=http://localhost:5173

# https://console.anthropic.com — used to generate the daily AI Brief.
ANTHROPIC_API_KEY=

# Pick anything; required header (X-Admin-Token) to hit POST /api/ai-brief/regenerate.
# Keeps the regenerate endpoint from being trivially triggered by anyone on your LAN.
ADMIN_TOKEN=
